{
  "name": "krusch-coding-harness",
  "version": "0.1.0",
  "description": "Postgres-backed coding harness that stages diffs, runs tests, and only then writes the working tree.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./hitl": {
      "types": "./types/agentic-15.d.ts",
      "default": "./src/approvals/hitl-slack-gate.js"
    },
    "./cost-killswitch": {
      "types": "./types/agentic-15.d.ts",
      "default": "./src/router/cost-killswitch.js"
    },
    "./browser-fallback": {
      "types": "./types/agentic-15.d.ts",
      "default": "./src/tools/api-browser-fallback.js"
    },
    "./trajectory-eval": {
      "types": "./types/agentic-15.d.ts",
      "default": "./src/eval/trajectory-dag-gate.js"
    }
  },
  "files": [
    "bin",
    "src",
    "db",
    "types",
    "test/fixtures/golden-trajectories-100.json",
    "LICENSE",
    "README.md",
    "docker-compose.yml"
  ],
  "bin": {
    "krusch-coding-harness": "./bin/krusch.js",
    "krusch-harness": "./bin/krusch.js",
    "krusch": "./bin/krusch.js"
  },
  "scripts": {
    "start": "node bin/krusch.js",
    "mcp": "node bin/krusch.js mcp",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "eval:trajectories": "node bin/krusch.js eval-trajectories --strict",
    "migrate": "node db/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "coding-harness",
    "agentic-ai",
    "postgres",
    "llm-router",
    "cascade",
    "mcp"
  ],
  "author": "Kevin Ruschman (KruschDev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruschdev/krusch-coding-harness.git"
  },
  "homepage": "https://github.com/kruschdev/krusch-coding-harness#readme",
  "bugs": {
    "url": "https://github.com/kruschdev/krusch-coding-harness/issues"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
