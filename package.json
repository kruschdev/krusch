{
  "name": "krusch",
  "version": "0.1.0",
  "description": "Postgres-backed coding harness that stages diffs, runs tests, and only then writes the working tree.",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "files": [
    "bin",
    "src",
    "db",
    "types",
    "LICENSE",
    "README.md",
    "docker-compose.yml"
  ],
  "bin": {
    "krusch": "./bin/krusch.js"
  },
  "scripts": {
    "start": "node bin/krusch.js",
    "mcp": "node bin/krusch.js mcp",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "migrate": "node db/migrate.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "coding-harness",
    "agentic-ai",
    "postgres",
    "llm-router",
    "cascade",
    "mcp"
  ],
  "author": "Kevin Ruschman (KruschDev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kruschdev/krusch.git"
  },
  "homepage": "https://github.com/kruschdev/krusch#readme",
  "bugs": {
    "url": "https://github.com/kruschdev/krusch/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
