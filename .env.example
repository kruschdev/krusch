# PostgreSQL Database URL (points to kdcode container on localhost:5432 or kruschserv)
DATABASE_URL=postgresql://kdcode:password@localhost:5432/kdcode

# LLM Providers (All optional; configured dynamically via cascade router)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Fleet Endpoints
OLLAMA_HOST=http://localhost:11434
FLEET_REASONING_HOST=http://localhost:5440

# Verification & Gating Defaults
CRUSH_AUTO_APPROVE=false
CRUSH_DEFAULT_PHASE=PLAN
CRUSH_LOG_LEVEL=info
