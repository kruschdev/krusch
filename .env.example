# PostgreSQL Connection URL
# Default matches docker-compose.yml configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krusch

# Optional Cloud Provider API Keys (leave blank for local/mock execution)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local Fleet Endpoints
OLLAMA_HOST=http://localhost:11434

# Krusch Harness Operational Flags
KRUSCH_AUTO_APPROVE=false
KRUSCH_LOG_LEVEL=info
KRUSCH_LEASE_TTL_MINUTES=15
